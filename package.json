{
  "name": "node-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS 模块化单体 Node 服务脚手架（业务无关，复制即用）",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dead": "knip",
    "dup:check": "jscpd --threshold 5 --reporters console --silent src test",
    "audit:deps": "pnpm audit --audit-level=high",
    "license:check": "node scripts/license-check.mjs",
    "sbom:generate": "node scripts/sbom-generate.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "schema:validate": "prisma validate",
    "db:up": "docker compose -f deploy/compose.dev.yaml up -d",
    "db:down": "docker compose -f deploy/compose.dev.yaml down"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.18.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.7.4",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
